# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
DEFAULT_MODEL=gpt-4
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300

# Memory Configuration
MEMORY_TYPE=chroma
MEMORY_PERSIST_DIRECTORY=./data/memory

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# Development
DEBUG=false

# Langflow Configuration
LANGFLOW_ENABLED=true
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860

# A2A Communication
A2A_NETWORK_ENABLED=true
A2A_NETWORK_PORT=8080

# A2A Message Tracing
A2A_TRACING_ENABLED=true
A2A_TRACE_RETENTION_DAYS=7
A2A_TRACE_CLEANUP_HOURS=24
A2A_TRACE_DB_PATH=./data/a2a_traces.db